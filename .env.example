# ============================================================
# SERENA (Technical Serena) - environment configuration
# Copy this file to ".env" and fill in real values.
# ============================================================

# 1. Open Telegram, search @BotFather -> /newbot -> paste token here
BOT_TOKEN=123456789:AAExampleTokenReplaceMeWithRealOne

# The product name shown in the bot (cards, welcome message, web app)
BRAND_NAME=SERENA

# How often (in minutes) the bot should check the job portals for new jobs
CHECK_INTERVAL_MINUTES=30

# Bot owner Telegram usernames (without @), comma separated.
# Owners can use /stats, /broadcast, /scrape_now, /reply and /sources
OWNER_USERNAMES=TechnicalSerena,Xioqui_xin

# The owner handle users are pointed to (/contact, "Contact owner" button)
OWNER_PRIMARY=TechnicalSerena

# Storage backend: "sqlite" (default, zero setup) or "mongodb"
DATABASE_BACKEND=sqlite
# SQLite database file (mount a volume here so data survives restarts)
DATABASE_PATH=data/bot.db
# --- MongoDB options (only used when DATABASE_BACKEND=mongodb) ---
# Get a free 512 MB cluster at https://www.mongodb.com/cloud/atlas
# MONGODB_URI=mongodb+srv://USER:PASS@cluster.example.mongodb.net/?retryWrites=true&w=majority
# MONGODB_DATABASE=sarkari_job_bot

# Tiny health-check web server (REQUIRED for Render "web service" plan)
ENABLE_HEALTH_SERVER=true
PORT=8080

# ------------------------------------------------------------
# Scraper settings - data source chain
# ------------------------------------------------------------
# The original www.sarkariresult.com is behind CloudFront and blocks most
# datacenter IPs (Render/Voroa/etc). The WordPress mirror below is NOT behind
# CloudFront and is therefore the default primary source.
MIRROR_BASE_URL=https://sarkariresult.com.cm
MIRROR_LISTING_PATH=/latest-jobs/

# Section pages of the mirror - used by /admit and /result
MIRROR_ADMIT_CARD_PATH=/admit-card/
MIRROR_RESULT_PATH=/result/

ORIGINAL_BASE_URL=https://www.sarkariresult.com
ORIGINAL_LISTING_PATH=/latestjob/

# How many jobs are taken from ONE source (the listing is newest first).
MAX_LISTING_JOBS=120

# Every N-th cycle (and every cycle after a failure) the bot reads ALL
# reachable sources and merges them - a notice that only one source carries
# is never missed. 1 = every cycle.
SWEEP_EVERY_CYCLES=6

# Sources tried in order until one returns jobs:
#   mirror       -> sarkariresult.com.cm (direct HTML, works on cloud hosts)
#   mirror-jina  -> the same mirror through the reader proxy (backup)
#   original     -> www.sarkariresult.com direct (works on residential IPs)
#   original-jina-> the original through the reader proxy (last resort)
SOURCE_ORDER=mirror,mirror-jina,original,original-jina

# Reader proxy used as the last resort. CloudFront currently blocks it too,
# but keep enabled in case that changes. Add a key for higher rate limits.
USE_JINA_FALLBACK=true
JINA_API_KEY=

# Politeness / safety limits
MAX_DETAIL_FETCHES_PER_RUN=8
REQUEST_DELAY_SECONDS=2

# ------------------------------------------------------------
# v1.5 - optional extras (all safe to leave empty / disabled)
# ------------------------------------------------------------

# Keeps the onboarding conversation alive across restarts (a button pressed
# after a redeploy still works). Leave empty to disable.
PERSISTENCE_PATH=data/conversation.pickle

# Daily digest - one message every morning at 09:05 IST with the new jobs
# of the last 24 h + the saved jobs closing within 3 days.
DIGEST_ENABLED=true
DIGEST_HOUR=9

# Watch live notices for changes (admit card published, exam date fixed,
# last date extended) and alert the people who already got that job.
WATCH_JOBS_PER_RUN=4
WATCH_WINDOW_DAYS=21

# Card language: "en", "hi" or "both" (Hindi block under the English card)
CARD_LANGUAGE=both

# --- Optional AI summaries (Groq, free tier) ---
# Get a key at https://console.groq.com/keys . Without a key the bot shows
# the original eligibility text (nothing breaks).
# GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxx
GROQ_MODEL=llama-3.3-70b-versatile
AI_SUMMARY_ENABLED=true
AI_SUMMARY_LANGUAGE=en

# --- Broadcast channel (optional) ---
# Every new vacancy is mirrored into this channel: @your_channel or
# -1001234567890. Add the bot as an admin there.
# BROADCAST_CHANNEL_ID=@your_channel

# ------------------------------------------------------------
# v1.6 - stickers (the "premium" greeting)
# ------------------------------------------------------------
# A bot may only use the $ (custom) emoji of a pack it owns, so the premium
# look is done with a sticker set the bot owns:
#   python scripts/create_sticker_set.py <your_telegram_user_id>
# then put the printed name here - the bot greets every user with a random
# sticker of that set.
# STICKER_SET_NAME=serena_by_serena_bot
# ... or one single sticker (file id):
# WELCOME_STICKER_FILE_ID=

# ------------------------------------------------------------
# v1.6 - web dashboard (optional FastAPI app)
# ------------------------------------------------------------
# 1) pip install -r requirements-web.txt   (or use the Docker image, it has it)
# 2) Set the four values below
# 3) Restart the bot - the dashboard is served on PORT (the platform port)
#
# ENABLE_WEB_APP=true
# WEB_APP_SECRET=<paste a random string, e.g. 32+ characters>
# PUBLIC_BASE_URL=https://your-service.onrender.com
#
# WEB_APP_PORT: leave it EMPTY. The dashboard then uses PORT - the only port
# the public URL reaches - and answers /health itself. IMPORTANT: the service
# must listen on EXACTLY ONE port, otherwise Voroa aborts the deployment
# ("your service is listening on more than one port").
# WEB_APP_PORT=
#
# How it works: a user sends /webapp in Telegram, the bot replies with an
# "Open Dashboard" button that carries a signed one-time link for that user
# (HMAC of the user id with WEB_APP_SECRET). The dashboard then shows the
# full job list with filters and a profile editor.
# Generate a secret with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
