# ============================================================
# Sarkari Job Alert Bot - environment configuration
# Copy this file to ".env" and fill in real values.
# ============================================================

# 1. Open Telegram, search @BotFather -> /newbot -> paste token here
BOT_TOKEN=123456789:AAExampleTokenReplaceMeWithRealOne

# How often (in minutes) the bot should check Sarkari Result for new jobs
CHECK_INTERVAL_MINUTES=30

# Bot owner Telegram usernames (without @), comma separated.
# Owners can use /stats, /broadcast and /scrape_now
OWNER_USERNAMES=TechnicalSerena,Xioqui_xin

# Storage backend: "sqlite" (default, zero setup) or "mongodb"
DATABASE_BACKEND=sqlite
# SQLite database file (mount a volume here so data survives restarts)
DATABASE_PATH=data/bot.db
# --- MongoDB options (only used when DATABASE_BACKEND=mongodb) ---
# Get a free 512 MB cluster at https://www.mongodb.com/cloud/atlas
# MONGODB_URI=mongodb+srv://USER:PASS@cluster.example.mongodb.net/?retryWrites=true&w=majority
# MONGODB_DATABASE=sarkari_job_bot

# Tiny health-check web server (REQUIRED for Render "web service" plan)
ENABLE_HEALTH_SERVER=true
PORT=8080

# ------------------------------------------------------------
# Scraper settings - data source chain
# ------------------------------------------------------------
# The original www.sarkariresult.com is behind CloudFront and blocks most
# datacenter IPs (Render/Voroa/etc). The WordPress mirror below is NOT behind
# CloudFront and is therefore the default primary source.
MIRROR_BASE_URL=https://sarkariresult.com.cm
MIRROR_LISTING_PATH=/latest-jobs/
ORIGINAL_BASE_URL=https://www.sarkariresult.com
ORIGINAL_LISTING_PATH=/latestjob/

# Sources tried in order until one returns jobs:
#   mirror | original | original-jina
SOURCE_ORDER=mirror,original,original-jina

# Reader proxy used as the last resort. CloudFront currently blocks it too,
# but keep enabled in case that changes. Add a key for higher rate limits.
USE_JINA_FALLBACK=true
JINA_API_KEY=

# Politeness / safety limits
MAX_DETAIL_FETCHES_PER_RUN=8
REQUEST_DELAY_SECONDS=2

# ------------------------------------------------------------
# v1.5 - optional extras (all safe to leave empty / disabled)
# ------------------------------------------------------------

# Keeps the onboarding conversation alive across restarts (a button pressed
# after a redeploy still works). Leave empty to disable.
PERSISTENCE_PATH=data/conversation.pickle

# Daily digest - one message every morning at 09:05 IST with the new jobs
# of the last 24 h + the saved jobs closing within 3 days.
DIGEST_ENABLED=true
DIGEST_HOUR=9

# Watch live notices for changes (admit card published, exam date fixed,
# last date extended) and alert the people who already got that job.
WATCH_JOBS_PER_RUN=4
WATCH_WINDOW_DAYS=21

# Card language: "en", "hi" or "both" (Hindi block under the English card)
CARD_LANGUAGE=both

# --- Optional AI summaries (Groq, free tier) ---
# Get a key at https://console.groq.com/keys . Without a key the bot shows
# the original eligibility text (nothing breaks).
# GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxx
GROQ_MODEL=llama-3.3-70b-versatile
AI_SUMMARY_ENABLED=true
AI_SUMMARY_LANGUAGE=en

# --- Broadcast channel (optional) ---
# Every new vacancy is mirrored into this channel: @your_channel or
# -1001234567890. Add the bot as an admin there.
# BROADCAST_CHANNEL_ID=@your_channel

# --- Web dashboard (optional) ---
# pip install -r requirements-web.txt
# ENABLE_WEB_APP=true
# WEB_APP_PORT=8081
# WEB_APP_SECRET=change-me-to-a-long-random-string
# PUBLIC_BASE_URL=https://your-bot-domain.example.com
